<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Evony Monster Database & Stamina Calculator</title>
    <!-- Tailwind CSS for clean, modern styling -->
    <script src="https://tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-gray-100 font-sans min-h-screen pb-12">

    <!-- Header -->
    <header class="bg-gray-800 border-b border-gray-700 py-6 text-center shadow-lg">
        <h1 class="text-3xl font-extrabold text-amber-400 tracking-wide">EVONY MONSTER TOOL</h1>
        <p class="text-gray-400 mt-1 text-sm">Endgame Bosses, Event Tiers, and Stamina Return Matrix</p>
    </header>

    <main class="max-w-7xl mx-auto px-4 mt-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
       
        <!-- Left Column: Controls & Calculator Inputs -->
        <section class="lg:col-span-1 bg-gray-800 p-6 rounded-xl border border-gray-700 shadow-md h-fit">
            <h2 class="text-xl font-bold text-amber-400 mb-4 border-b border-gray-700 pb-2">🎯 Configuration</h2>
           
            <!-- Monster Selector -->
            <div class="mb-5">
                <label for="monsterSelect" class="block text-sm font-semibold mb-2">Select Target Monster</label>
                <select id="monsterSelect" class="w-full bg-gray-700 border border-gray-600 rounded-lg p-2.5 text-white focus:ring-2 focus:ring-amber-500 focus:outline-none">
                    <!-- JavaScript populates categories here dynamically -->
                </select>
            </div>

            <!-- Stamina Input -->
            <div class="mb-6">
                <label for="staminaInput" class="block text-sm font-semibold mb-2">Available Stamina Pool</label>
                <input type="number" id="staminaInput" value="2000" min="0" class="w-full bg-gray-700 border border-gray-600 rounded-lg p-2.5 text-white font-mono text-lg focus:ring-2 focus:ring-amber-500 focus:outline-none">
               
                <!-- Presets -->
                <div class="grid grid-cols-3 gap-2 mt-3">
                    <button onclick="setStamina(500)" class="bg-gray-700 hover:bg-gray-600 text-xs py-1.5 px-2 rounded border border-gray-600 transition">500 Stam</button>
                    <button onclick="setStamina(2000)" class="bg-gray-700 hover:bg-gray-600 text-xs py-1.5 px-2 rounded border border-gray-600 transition">2,000 Stam</button>
                    <button onclick="setStamina(10000)" class="bg-gray-700 hover:bg-gray-600 text-xs py-1.5 px-2 rounded border border-gray-600 transition">10,000 Stam</button>
                </div>
            </div>

            <!-- Calculated Summary Card -->
            <div class="bg-gray-950 border border-amber-500/20 rounded-lg p-4 text-center">
                <p class="text-xs text-gray-400 uppercase tracking-widest">Calculated Results</p>
                <p id="totalKillsDisplay" class="text-4xl font-black text-amber-400 my-1">0</p>
                <p class="text-sm text-gray-300">Total Successful Kills / Rallies</p>
                <div class="mt-2 text-xs text-gray-500 border-t border-gray-800 pt-2 flex justify-between px-2">
                    <span>Cost per hit: <strong id="monsterCostDisplay" class="text-gray-300">0</strong></span>
                    <span>Leftover Stamina: <strong id="leftoverStaminaDisplay" class="text-gray-300">0</strong></span>
                </div>
            </div>
        </section>

        <!-- Right Column: Yield Outputs -->
        <section class="lg:col-span-2 space-y-6">
           
            <!-- Resources Category Card -->
            <div class="bg-gray-800 p-6 rounded-xl border border-gray-700 shadow-md">
                <h3 class="text-lg font-bold text-emerald-400 mb-4 flex items-center gap-2">
                    🌾 Resource Boxes Yielded
                </h3>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-700 text-center">
                        <span class="text-xs text-gray-400 block mb-1 font-semibold">Food Box</span>
                        <span id="res-food" class="text-lg font-mono font-bold text-white">0</span>
                    </div>
                    <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-700 text-center">
                        <span class="text-xs text-gray-400 block mb-1 font-semibold">Wood Box</span>
                        <span id="res-wood" class="text-lg font-mono font-bold text-white">0</span>
                    </div>
                    <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-700 text-center">
                        <span class="text-xs text-gray-400 block mb-1 font-semibold">Stone Box</span>
                        <span id="res-stone" class="text-lg font-mono font-bold text-white">0</span>
                    </div>
                    <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-700 text-center">
                        <span class="text-xs text-gray-400 block mb-1 font-semibold">Ore Box</span>
                        <span id="res-ore" class="text-lg font-mono font-bold text-white">0</span>
                    </div>
                </div>
            </div>

            <!-- Speedups Category Card -->
            <div class="bg-gray-800 p-6 rounded-xl border border-gray-700 shadow-md">
                <h3 class="text-lg font-bold text-cyan-400 mb-4 flex items-center gap-2">
                    ⏱️ Speedup Minutes Earned
                </h3>
                <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
                    <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-700 text-center">
                        <span class="text-xs text-gray-400 block mb-1 font-semibold">Common</span>
                        <span id="speed-common" class="text-md font-mono font-bold text-white">0</span>
                    </div>
                    <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-700 text-center">
                        <span class="text-xs text-gray-400 block mb-1 font-semibold">Training</span>
                        <span id="speed-training" class="text-md font-mono font-bold text-white">0</span>
                    </div>
                    <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-700 text-center">
                        <span class="text-xs text-gray-400 block mb-1 font-semibold">Research</span>
                        <span id="speed-research" class="text-md font-mono font-bold text-white">0</span>
                    </div>
                    <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-700 text-center">
                        <span class="text-xs text-gray-400 block mb-1 font-semibold">Build</span>
                        <span id="speed-construction" class="text-md font-mono font-bold text-white">0</span>
                    </div>
                    <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-700 text-center">
                        <span class="text-xs text-gray-400 block mb-1 font-semibold">Healing</span>
                        <span id="speed-healing" class="text-md font-mono font-bold text-white">0</span>
                    </div>
                </div>
            </div>

            <!-- General / Special Rewards Card -->
            <div class="bg-gray-800 p-6 rounded-xl border border-gray-700 shadow-md">
                <h3 class="text-lg font-bold text-amber-400 mb-4 flex items-center gap-2">
                    💎 Currency & Special Drops
                </h3>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-700 text-center">
                        <span class="text-xs text-gray-400 block mb-1 font-semibold">Gold</span>
                        <span id="misc-gold" class="text-md font-mono font-bold text-white">0</span>
                    </div>
                    <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-700 text-center">
                        <span class="text-xs text-gray-400 block mb-1 font-semibold">Monarch XP</span>
                        <span id="misc-monarchXp" class="text-md font-mono font-bold text-white">0</span>
                    </div>
                    <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-700 text-center">
                        <span class="text-xs text-gray-400 block mb-1 font-semibold">Special Item</span>
                        <span id="special-name" class="text-xs font-semibold text-amber-300 block truncate">-</span>
                        <span id="special-qty" class="text-md font-mono font-bold text-white">0</span>
                    </div>
                    <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-700 text-center">
                        <span class="text-xs text-gray-400 block mb-1 font-semibold">Rally Stamina</span>
                        <span id="misc-stamina" class="text-md font-mono font-bold text-white">0</span>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Master Database Script Execution Logic -->
    <script>
        // Full database object capturing exact game scaling ceilings requested
        const monsterDatabase = [
            // --- Normal Bosses (B15 to B23) ---
            { id: "b15", category: "Bosses (B15-B23)", name: "Phoenix (B15)", cost: 30, rewards: { food: 1500000, wood: 1500000, stone: 1500000, ore: 1500000, commonSpeed: 60, trainingSpeed: 30, researchSpeed: 30, constructionSpeed: 30, healingSpeed: 0, gold: 50000, monarchXp: 2000, specialItem: "Scroll Chest", specialQty: 1 } },

